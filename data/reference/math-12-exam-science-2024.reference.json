        {
          "textKh": "ដំណោះស្រាយទូទៅ",
          "text": "General solution for complex conjugate roots α±βi",
          "latex": "y = e^x(A\\cos 2x + B\\sin 2x),\\quad A,B\\in\\mathbb{R}",
          "explanationKh": "ប្រើ α=1, β=2",
          "explanation": "Use α=1 (real part), β=2 (imaginary part)"
        },
        {
          "textKh": "y(0)=2: A=2",
          "text": "Apply y(0)=2",
          "latex": "y(0)=e^0(A\\cos 0+B\\sin 0)=A=2"
        },
        {
